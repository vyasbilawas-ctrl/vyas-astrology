# Copy these keys into Streamlit Cloud → your app → Settings → Secrets.
# NEVER commit the real file (.streamlit/secrets.toml is git-ignored).
#
# Google Cloud Console setup (one-time):
#   1. APIs & Services → Credentials → OAuth client (Web application)
#   2. Authorized redirect URIs → add EXACTLY:
#        https://vyas-astrology-111.streamlit.app
#        http://localhost:8501                (local development only)
#   3. Google Auth Platform → Audience → add your Gmail under "Test users"
#      (or click "Publish app" to allow any Google account).
#
# Replace the two angle-bracket placeholders with the values from
# Google Cloud Console → Credentials. Do not paste real values into this
# template file — only into the Streamlit Cloud Secrets editor.

GOOGLE_CLIENT_ID = "<PASTE_CLIENT_ID_HERE>"
GOOGLE_CLIENT_SECRET = "<PASTE_CLIENT_SECRET_HERE>"

# Public origin of the deployed app (no trailing slash).
GOOGLE_REDIRECT_URI = "https://vyas-astrology-111.streamlit.app"

# ---------------------------------------------------------------------------
# PERSISTENT ACCOUNTS — Neon Postgres (strongly recommended)
# ---------------------------------------------------------------------------
# Streamlit Community Cloud wipes the app container on every reboot/redeploy.
# That erased the local SQLite file (vyas_users.db) and every account inside it.
# Point VYAS at a free Neon Postgres database once and accounts survive forever.
#
#   1. Create a free project at https://neon.tech (no card required).
#   2. Dashboard → Connect → copy the connection string (Python / psycopg):
#        postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#   3. Paste it below, keep the quotes, save, and reboot the app.
#
# Tables are created automatically on first start. Without this key VYAS falls
# back to local SQLite: fine on your laptop, but accounts vanish on redeploy.
DATABASE_URL = "<PASTE_NEON_CONNECTION_STRING_HERE>"
